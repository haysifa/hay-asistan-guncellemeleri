{
  "name": "hay-asistan",
  "version": "1.0.0",
  "description": "Bütüncül Analiz ve Bayi Yönetim Platformu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "electron-builder --win -p always"
  },
  "build": {
    "appId": "com.haysifa.hayasistan",
    "productName": "Hay Asistan",
    "files": [
      "**/*",
      ".env"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hay Asistan"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "haysifa",
        "repo": "hay-asistan-guncellemeleri"
      }
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}